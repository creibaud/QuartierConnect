# fail2ban — QuartierConnect configuration
#   cp ops/fail2ban-jail.local /etc/fail2ban/jail.local
#   systemctl enable --now fail2ban
#
# Two jails: SSH (reliable, always on) and caddy-auth (login failures).

[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = systemd

[sshd]
enabled = true
port    = ssh

# Bans IPs racking up 401s on /api/auth/login.
# Requires Caddy to write its JSON access logs to the logpath below (`log`
# block in the Caddyfile). Defence in depth on top of the application rate
# limit (LOGIN_RATE_LIMIT, @Throttle on /auth/login).
[caddy-auth]
enabled  = true
port     = http,https
filter   = caddy-auth
logpath  = /var/log/quartierconnect/caddy/access.log
maxretry = 5
findtime = 10m
bantime  = 1h
