# ─── PRODUCTION environment — QuartierConnect ────────────────────────────────
# Copy to the repo root as .env, then `chmod 600 .env` and fill in EVERY secret:
#   cp docker/.env.prod.example .env
# Generate a secret:  openssl rand -base64 32 | tr -d '/+='

# NestJS
PORT=5000
JWT_SECRET=<openssl rand -base64 48 | tr -d '/+='>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Production: the public HTTPS origin only.
CORS_ORIGINS=https://quartierconnect.duckdns.org

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=<strong password>
MONGO_URI=mongodb://root:<password>@mongo:27017/quartierconnect?authSource=admin

# PostgreSQL
POSTGRES_USER=qc
POSTGRES_PASSWORD=<strong password>
POSTGRES_DB=quartierconnect
POSTGRES_URL=postgresql://qc:<password>@postgres:5432/quartierconnect

# Neo4j (keep NEO4J_AUTH and NEO4J_USER/PASSWORD in sync)
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/<strong password>
NEO4J_USER=neo4j
NEO4J_PASSWORD=<strong password>

# DSL (inside the api container)
PYTHON_BIN=python3
DSL_PATH=/app/dsl

# Demo TOTP secret (only needed when seeding the demo accounts in production).
# NEVER reuse a public example secret — generate a unique base32 one:
#   python3 -c "import base64,os;print(base64.b32encode(os.urandom(20)).decode())"
DEMO_TOTP_SECRET=CHANGE_ME_BASE32_SECRET

# Production rate limit (login attempts / 15 min / IP)
LOGIN_RATE_LIMIT=5

# ─── Off-site backups (optional — used by scripts/backup-all.sh) ─────────────
# S3-compatible: AWS S3, Scaleway, Backblaze B2…
BACKUP_BUCKET=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
BACKUP_RETENTION_DAYS=7

# ─── Protected documentation (Caddy basic_auth on /dev, /docs, /scalar) ──────
# Username and bcrypt hash. Generate the hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# WARNING: docker compose expands $ in .env values (via --env-file, used by the
# deploy scripts). Double EVERY $ of the hash to $$ below, otherwise the hash is
# corrupted at startup (basic_auth breaks: Caddy error, or the right password
# rejected = lockout).  E.g.  $2a$14$abc…  ->  $$2a$$14$$abc…
DOCS_AUTH_USER=admin
DOCS_AUTH_HASH=<bcrypt hash, every $ doubled to $$>

# ─── Ops notifications (optional) ────────────────────────────────────────────
# Discord webhook for deploy + backup alerts
DISCORD_WEBHOOK=
# Public domain used by smoke-test.sh / deploy-vps.sh (without https://)
PROD_DOMAIN=quartierconnect.duckdns.org
# Site address served by Caddy. Set the public domain to enable Let's Encrypt
# auto-HTTPS; leave empty to stay on HTTP over :80.
SITE_ADDRESS=quartierconnect.duckdns.org
