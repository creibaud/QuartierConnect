(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
	}
}

# Scalar API reference bootstraps the UI with an inline <script>, so its CSP
# must allow 'unsafe-inline' for scripts (unlike the strict API/app CSP).
(scalar_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' ws: wss: http://localhost:5000 http://localhost/api https://api.scalar.com; frame-ancestors 'none'; worker-src blob:"
}

# Shared basic_auth for the Dev docs site and the Scalar API reference.
# Credentials come from the caddy container env (DOCS_AUTH_USER / DOCS_AUTH_HASH),
# with a dev-only default set in docker-compose.yml.
(docs_auth) {
	basic_auth {
		{$DOCS_AUTH_USER} {$DOCS_AUTH_HASH}
	}
}

{$SITE_ADDRESS::80} {
	import security_headers

	# Access logs in JSON for fail2ban (ops/fail2ban-filter-caddy-auth.conf).
	# In prod the file is bind-mounted to /var/log/quartierconnect/caddy.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}

	handle /api/docs* {
		import docs_auth
		import scalar_csp
		uri strip_prefix /api
		reverse_proxy api:5000
	}
	handle /api/scalar* {
		import docs_auth
		import scalar_csp
		uri strip_prefix /api
		reverse_proxy api:5000
	}
	handle /api/* {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: https://*.tile.openstreetmap.org; connect-src 'self' ws: wss:; font-src 'self'; frame-ancestors 'none'"
		uri strip_prefix /api
		reverse_proxy api:5000
	}
	handle /docs* {
		import docs_auth
		import scalar_csp
		reverse_proxy api:5000
	}
	handle /scalar* {
		import docs_auth
		import scalar_csp
		reverse_proxy api:5000
	}
	handle_path /telechargements/* {
		root * /srv/downloads
		file_server
	}
	handle /admin* {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.cartocdn.com; media-src 'self' blob:; connect-src 'self' ws: wss: https://*.cartocdn.com; font-src 'self' data:; worker-src blob:; frame-src 'self' blob:; frame-ancestors 'none'"
		reverse_proxy admin:3001
	}
	handle /aide* {
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-ancestors 'none'"
		reverse_proxy docs-user:3002
	}
	handle /dev* {
		import docs_auth
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-ancestors 'none'"
		reverse_proxy docs-dev:3003
	}
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://*.cartocdn.com; media-src 'self' blob:; connect-src 'self' ws: wss: https://*.cartocdn.com; font-src 'self' data:; worker-src blob:; frame-src 'self' blob:; frame-ancestors 'none'"
		reverse_proxy client:3000
	}
}
