:3000 {
	encode gzip

	# Content-hashed bundles can be cached forever, but the favicon keeps a
	# stable name, so exclude it here or its updates never reach browsers.
	@static {
		path_regexp \.(js|css|woff2?|ttf|svg|png|ico)$
		not path_regexp logo\.svg$
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	@favicon path_regexp logo\.svg$
	header @favicon Cache-Control "no-cache"

	handle_path /api/* {
		reverse_proxy api:5000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
