{
    "name": "web-apps",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "format": "pnpm format:root",
        "format:root": "prettier --write .",
        "typecheck": "turbo typecheck",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@playwright/test": "^1.59.1",
        "otplib": "^13.4.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "turbo": "^2.10.0",
        "typescript": "5.9.3"
    },
    "packageManager": "pnpm@9.15.9",
    "engines": {
        "node": ">=20"
    },
    "pnpm": {
        "overrides": {
            "handlebars": "4.7.9",
            "hono": "4.12.25",
            "lodash": "4.18.0",
            "picomatch@2": "2.3.2",
            "picomatch@4": "4.0.4",
            "tmp": "0.2.7",
            "ws": "8.21.0",
            "fast-uri": "3.1.2",
            "flatted": "3.4.2"
        }
    }
}
